---
import '../styles/global.css';
const {title='Jacques Belmont | Engenharia, IA e Pesquisa',description='Engenharia de software, inteligência artificial e pesquisa aplicada.'}=Astro.props;
const home=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"/>
  <base href={home}/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#fafafa"/>
  <meta name="description" content={description}/>
  <link rel="icon" type="image/svg+xml" href="favicon.svg"/>
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/>
  <title>{title}</title>
</head>
<body>
  <a class="skip" href="#conteudo">Ir para o conteúdo</a>
  <header class="header container">
    <a class="brand" href="">JB<span class="brand-divider"> / </span> Jacques Belmont<span class="dot">.</span></a>
    <nav class="nav" aria-label="Navegação principal">
      <a href="">Início</a><a href="projetos/">Projetos</a><a href="pesquisa/">Pesquisa</a>
      <a href="publicacoes/">Publicações</a><a href="curriculo/">Currículo</a>
      <a class="contact" href="https://github.com/jacquesbelmont" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
  </header>
  <main id="conteudo" class="container"><slot/></main>
  <footer class="footer"><div class="container">© {new Date().getFullYear()} Jacques Belmont · Engenharia, Inteligência Artificial e Pesquisa Aplicada</div></footer>
</body>
</html>
